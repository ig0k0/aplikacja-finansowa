# Reverse proxy z automatycznym HTTPS (Let's Encrypt).
# Domena pochodzi ze zmiennej CFO_DOMAIN (plik .env w katalogu glownym repo).
# Caddy jest jedynym punktem wejscia: X-Forwarded-For od klienta jest nadpisywany
# prawdziwym adresem (brak trusted_proxies), wiec limit logowania nie da sie obejsc.

{$CFO_DOMAIN} {
	encode gzip zstd

	# Limit wielkosci uploadu (importy CSV/XLSX/PDF/zdjecia).
	request_body {
		max_size 25MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		X-Robots-Tag "noindex, nofollow"
		-Server
		-X-Powered-By
	}

	reverse_proxy app:3000 {
		header_up X-Real-IP {remote_host}
	}

	log {
		output stderr
		format console
	}
}
