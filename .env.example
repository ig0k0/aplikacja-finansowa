DATABASE_URL=./data/app.db
# Wymagane. Na produkcji min. 32 losowe znaki — wartosc przykladowa jest odrzucana przy starcie.
#   openssl rand -hex 32
SESSION_SECRET=change-me-before-use

# VPS / HTTPS (za Caddy lub nginx)
# APP_URL=https://finanse.example.com
# TRUST_PROXY=1
# COOKIE_SECURE=1
# FORCE_HSTS=1
# TRUST_PROXY=1 oznacza: przed aplikacja stoi WLASNE reverse proxy i jego naglowkom mozna ufac.
# Bez tego adres klienta z X-Forwarded-For jest ignorowany (kazdy moze go podrobic).
# Za Cloudflare (tunel) wskaz naglowek z prawdziwym adresem klienta:
# CLIENT_IP_HEADER=cf-connecting-ip
# Limit blednych prob na pare login + adres / na sam login (okno 15 min):
# LOGIN_RATE_LIMIT_MAX=8
# LOGIN_RATE_LIMIT_LOGIN_MAX=20
# LOGIN_RATE_LIMIT_DISABLED=0

# Wymagane do backupu; min. 16 znakow, wartosc przykladowa jest odrzucana.
#   openssl rand -base64 32
# Zapisz kopie klucza poza serwerem (menedzer hasel) — bez niego backupu nie da sie odtworzyc.
BACKUP_ENCRYPTION_KEY=change-me-backup-key
BACKUP_DESTINATION=./backups
# Opcjonalnie: przy npm run backup:scheduled — usun pliki starsze niz N dni (0 = wylacz)
# BACKUP_RETENTION_DAYS=14
# Opcjonalnie: zaszyfrowany backup do Google Drive przez rclone.
# Nazwe zdalnego polaczenia utworz poza repozytorium: rclone config
# GOOGLE_DRIVE_RCLONE_REMOTE=google-drive
# GOOGLE_DRIVE_RCLONE_PATH=centrum-finansow/backup
# RCLONE_CONFIG=/bezpieczna/sciezka/rclone.conf

# AI (OpenAI-compatible, np. Ollama http://127.0.0.1:11434/v1)
AI_MODE=disabled
# AI_MODE=local
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_MODEL=llama3.2
# AI_API_KEY=
# AI_CONFIDENCE_AUTO=0.85
# AI_CONFIDENCE_REVIEW=0.6

SEED_USER_1_LOGIN=igor
SEED_USER_1_DISPLAY_NAME=Igor
SEED_USER_1_PASSWORD=change-me-user-1

SEED_USER_2_LOGIN=user2
SEED_USER_2_DISPLAY_NAME=Uzytkownik 2
SEED_USER_2_PASSWORD=change-me-user-2
